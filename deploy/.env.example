# Copy to .env and fill in real values before running docker compose.

# Your public domain (used in Keycloak hostname and oauth2-proxy redirect URLs)
FAVA_DOMAIN=fava.example.com

# Directory on the host containing your .beancount files
BEANCOUNT_DIR=/home/user/beancount

# Colon-separated list of beancount files (paths inside the container)
BEANCOUNT_FILE=/beancount/joint.beancount:/beancount/alice.beancount

# Keycloak database password
KC_DB_PASSWORD=changeme

# Keycloak bootstrap admin credentials
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=changeme

# oauth2-proxy OIDC client credentials (copy from Keycloak admin → Clients → fava → Credentials)
OAUTH2_CLIENT_ID=fava
OAUTH2_CLIENT_SECRET=

# Random secret for oauth2-proxy session cookies — must be exactly 16, 24 or 32 bytes.
# Generate with: openssl rand -hex 16
OAUTH2_COOKIE_SECRET=
